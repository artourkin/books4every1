# Copy to .env and choose a long, unique password.
FOLIO_PASSWORD=replace-with-a-long-unique-password
# Set true when serving over HTTPS through a reverse proxy.
FOLIO_SECURE_COOKIE=false

# Compose host binding. For LAN access, set this to the server's LAN IP.
FOLIO_BIND_ADDR=127.0.0.1
FOLIO_PORT=8080
